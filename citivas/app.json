{
  "expo": {
    "name": "Citivas",
    "slug": "citivas",
    "scheme": "citivas",
    "version": "2.2.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.svg",
      "**/*.webp",
      "**/*.ttf",
      "**/*.otf"
    ],
    "android": {
      "package": "com.bwtng.citivas",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E88E5"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.bwtng.citivas",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Citivas uses your location to show hotels, restaurants and events near you, and to switch to your current city automatically."
      }
    },
    "plugins": [
      "expo-location",
      "expo-font",
      "expo-image-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "kotlinVersion": "2.1.20",
            "extraMavenRepos": []
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#0A2540"
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "./plugins/withRemoveDeprecatedSystemBarColors"
    ],
    "extra": {
      "eas": {
        "projectId": "8f3ebcf5-6057-4900-86fa-ac2d81cf2557"
      }
    },
    "owner": "bluewaves_tech",
    "experiments": {
      "tsconfigPaths": true
    }
  }
}

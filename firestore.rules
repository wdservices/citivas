rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ── Admin Users ──
    match /admin_users/{adminId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Businesses (also used for Events with category="Event") ──
    // All listings (properties, products, events, restaurants) OPTIONALLY live under a business.
    // Individual sellers can list without a business — those writes go directly to the
    // top-level legacy collections (house_listings / marketplace / events) below.
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // ── Properties (shortlet/rent/land/commercial) - OPTIONAL under business ──
      // Supported subTypes + fields (each subType stores additional subtype-specific fields):
      // - rent:
      //     billingPeriod (1 Year | 2 Years | 1.5 Years | 6 Months | Monthly),
      //     bedrooms, bathrooms, hasStore/hasKitchenStore, furnishing, serviceCharge,
      //     cautionFee, legalFee, agencyFee, availableFrom, totalPackage,
      //     houseType (Duplex/Bungalow/Flat/etc), roadCondition (Tarred/Motorable/Bad/Gated),
      //     roadImage, roadImagePublicId, rentServiceCharge
      // - shortlet_hotel:
      //     via /mini-site-wizard; creates property (miniSiteActive=true) + rooms subcollection.
      //     Also discoverable in marketplace as any other listing.
      // - land:
      //     plotSize, sizeUnit (sqm/acres/plots/hectares), titleDocument/titleType,
      //     landUseType, topography, accessRoad, fenced/isFenced, surveyPlan/hasSurveyPlan,
      //     landSaleType (sale/hire/lease), lat, lon
      // - commercial:
      //     commercialType (Hall/Office/Shop/Warehouse/Plaza/Co-working/Restaurant/
      //                     Filling Station/Church-Mosque/Other),
      //     spaceSizeSqm, capacity/seatingCapacity, hasParking, hasSecurity, hasWater,
      //     hasPower/hasElectricity, hasAC, hasInternet/hasWifi, hasElevator, hasCanteen,
      //     billingPeriod (year/2yr/6mo/month/event-day / outright-sale),
      //     usages, serviceCharge, cautionFee, legalFee, agencyFee, amenities (array),
      //     miniSiteActive (false for rent/land/commercial, true for shortlet_hotel)
      // Common fields across all subTypes:
      //     sellerType ("individual" | "business"), businessId (null | bid),
      //     businessName, ownerId, state, city, streetAddress, lat, lon, location,
      //     title, description, propertySubType, type, price, priceNum, image, images,
      //     imagePublicIds, bedrooms (0 for land/commercial), bathrooms, guests,
      //     amenities, status, rating, reviews, createdAt, updatedAt
      match /properties/{propertyId} {
        allow read: if true;
        allow create: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        allow update, delete: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;

        // Rooms nested under shortlet properties
        match /rooms/{roomId} {
          allow read: if true;
          allow create, update, delete: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        }
      }

      // ── Products (marketplace items) - MUST be under business ──
      match /products/{productId} {
        allow read: if true;
        allow create: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        allow update, delete: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
      }

      // ── Restaurants ──
      match /restaurants/{restaurantId} {
        allow read: if true;
        allow create: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        allow update, delete: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;

        match /menu/{menuItemId} {
          allow read: if true;
          allow create, update, delete: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        }
      }

      // ── Events - MUST be under business (enforces business-first flow) ──
      match /events/{eventId} {
        allow read: if true;
        allow create: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        allow update, delete: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;

        match /ticketTypes/{ticketTypeId} {
          allow read: if true;
          allow create, update, delete: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        }
      }

      // ── Generic menu (alternative path used by some clients) ──
      match /menu/{menuItemId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
      }

      // ── Business reviews ──
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      }

      // ── Business activity log (chat notifications, etc.) ──
      match /activityLog/{entryId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }

      // ── Event ticket tiers (legacy path) ──
      match /tickets/{ticketId} {
        allow read: if true;
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/businesses/$(businessId)).data.organizerId == request.auth.uid ||
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
        );
        allow update: if request.auth != null && (
          get(/databases/$(database)/documents/businesses/$(businessId)).data.organizerId == request.auth.uid ||
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
        );
        allow delete: if request.auth != null && (
          get(/databases/$(database)/documents/businesses/$(businessId)).data.organizerId == request.auth.uid ||
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
        );
      }
    }

    // ── Chats (business <-> customer messaging) ──
    // Uses a `participants` array [customerId, businessOwnerId] so both
    // parties can read/write. Security rules check `auth.uid in participants`.
    match /chats/{chatId} {
      allow read, write: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid in request.resource.data.participants
      );

      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
      }
    }

    // ── Purchased ticket records (top-level, separate from the tier
    // inventory subcollection above) ──
    // NOTE: no write path to this collection exists anywhere in the client
    // codebase as of this writing — EventTicketsPage.tsx only ever READS
    // from it (querying sales counts). This means either ticket purchases
    // aren't actually being recorded here yet (a real gap to close before
    // "tickets sold" figures can be trusted), or they're written through a
    // mechanism not yet found in this codebase. Read is allowed broadly for
    // now so the existing sales-count queries don't break; revisit the
    // write rule once the actual purchase-recording flow is confirmed.
    match /tickets/{ticketRecordId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Users ──
    // Clients list a small subset of basic fields (name email createdAt ) is required for the
    // diagnostic Database Explorer card in the profile dashboard.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── Marketplace / House Listings / Events (LEGACY top-level - TRANSITION) ──
    // Keep read+write allowed during migration. New code should use business subcollections.
    // TODO: after all clients migrate, change to allow create, update, delete: if false to enforce business-first only.
    match /marketplace/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource == null || resource.data.ownerId == request.auth.uid);
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    match /house_listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource == null || resource.data.ownerId == request.auth.uid);
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource == null || resource.data.ownerId == request.auth.uid);
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    // Flat index collections (deleted) - keep read open for migration, no writes
    match /property_index/{docId} { allow read: if true; allow write: if false; }
    match /product_index/{docId} { allow read: if true; allow write: if false; }
    match /event_index/{docId} { allow read: if true; allow write: if false; }
    match /properties/{docId} { allow read: if true; allow write: if false; }
    match /products/{docId} { allow read: if true; allow write: if false; }

    // ── Favourites ──
    match /favourites/{favouriteId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ── Wallets ──
    match /wallets/{walletId} {
      allow read: if request.auth != null && request.auth.uid == walletId;
      allow create: if request.auth != null && request.auth.uid == walletId;
      allow update: if request.auth != null && request.auth.uid == walletId;
      allow delete: if false;

      // ── Wallet transaction history ──
      // Only the wallet owner can read their own transaction history.
      // Admin aggregation should use a Cloud Function with Admin SDK
      // (bypasses rules server-side) rather than a permissive client read.
      match /transactions/{transactionId} {
        allow read: if request.auth != null && request.auth.uid == walletId;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Transactions (legacy top-level) ──
    match /transactions/{transactionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // ── Ads ──
    match /ads/{adId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── Feedback ──
    match /feedback/{feedbackId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Reviews ──
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

// ── Ticket Orders ──
    match /ticket_orders/{orderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.buyerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
    }

    // ── Property Bookings ──
    match /property_bookings/{bookingId} {
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.payerId == request.auth.uid ||
        resource.data.guestEmail == request.auth.token.email
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── Activity Logs ──
    match /activity_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Mini-site removals (admin hides a seeded mini website) ──
    match /mini_site_removals/{slug} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if false;
    }

    // ── Food Items ──
    match /foodItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ── Food Categories ──
    match /foodCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ── User Image Asset Library ──
    match /user_uploads/{uploadId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ── Catch-all: deny everything else ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
